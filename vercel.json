{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/m01", "destination": "/" },
    { "source": "/wp-content/(.*)", "destination": "/the.invisimple.id/wp-content/$1" },
    { "source": "/wp-includes/(.*)", "destination": "/the.invisimple.id/wp-includes/$1" },
    { "source": "/wp-json/(.*)", "destination": "/the.invisimple.id/wp-json/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts.gstatic.com/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|gif|svg|webp|woff|woff2|ttf|mp3|mp4)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js|mjs)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
